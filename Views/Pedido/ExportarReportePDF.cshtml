@model IEnumerable<CafeteriaWeb.Dtos.PedidoDto>
@{
    Layout = null; // ELIMINAMOS EL MENU WEB PARA QUE SOLO SALGA EL DOCUMENTO LIMPIO
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>Reporte_General_Ventas</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
    <style>
        body {
            padding: 30px;
            font-family: 'Arial', sans-serif;
        }

        .report-header {
            border-bottom: 2px solid #333;
            margin-bottom: 20px;
            padding-bottom: 10px;
        }

        thead {
            background-color: #f8f9fa;
        }
    </style>
</head>
<body>

    <div class="report-header d-flex justify-content-between align-items-center">
        <div>
            <h2>☕ CAFETERÍA WEB</h2>
            <p class="text-muted m-0">Reporte Oficial de Ventas y Transacciones</p>
        </div>
        <div class="text-end">
            <strong>Fecha de Emisión:</strong> @DateTime.Now.ToString("dd/MM/yyyy")<br>
            <strong>Generado por:</strong> Sistema Administrativo
        </div>
    </div>

    <h4 class="mb-4 text-center text-uppercase fw-bold text-secondary">Historial Consolidado de Pedidos</h4>

    <table class="table table-striped table-bordered align-middle">
        <thead>
            <tr class="table-dark text-center">
                <th>ID Pedido</th>
                <th>Cliente</th>
                <th>Fecha y Hora</th>
                <th>Total General</th>
                <th>Estado</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td class="text-center fw-bold">#@item.IdPedido</td>
                    <td>@item.NombreCliente</td>
                    <td class="text-center">@item.Fecha.ToString("dd/MM/yyyy HH:mm")</td>
                    <td class="text-end fw-bold text-success">S/ @item.Total.ToString("0.00")</td>
                    <td class="text-center">
                        <span class="badge bg-success">@item.Estado</span>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <div class="mt-5 text-center text-muted" style="font-size: 11px;">
        <p>Fin del reporte de auditoría transaccional - Proyecto .NET 9 Cafetería</p>
    </div>

    <script>
        // EJECUTA LA EXPORTACION AUTOMATICA A PDF AL CARGAR LA PANTALLA
        window.onload = function () {
            window.print();
        }
    </script>
</body>
</html>