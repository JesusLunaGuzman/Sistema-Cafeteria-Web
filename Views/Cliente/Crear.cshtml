@model CafeteriaWeb.Dtos.ClienteDto
@{
    ViewData["Title"] = "Nuevo Cliente";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow">
                <div class="card-header bg-success text-white">
                    <h4 class="mb-0">Registrar Nuevo Cliente</h4>
                </div>
                <div class="card-body">
                    <form asp-action="Crear" method="post">

                        <div class="mb-3">
                            <label class="form-label fw-bold">Nombre del Cliente</label>
                            <input asp-for="Nombre" class="form-control" placeholder="Ej: Juan Pérez" required />
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">Correo Electrónico (Opcional)</label>
                            <input asp-for="Email" type="email" class="form-control" placeholder="Ej: juan@correo.com" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">Teléfono (Opcional)</label>
                            <input asp-for="Telefono" class="form-control" placeholder="Ej: 987654321" />
                        </div>

                        <div class="d-flex justify-content-between mt-4">
                            <a asp-action="Index" class="btn btn-secondary">Volver a la lista</a>
                            <button type="submit" class="btn btn-success">Guardar Cliente</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>