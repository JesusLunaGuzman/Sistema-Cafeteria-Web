@model CafeteriaWeb.Dtos.ProductoDto

@{
    ViewData["Title"] = "Editar Producto";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow">
                <div class="card-header bg-warning text-dark">
                    <h4 class="mb-0">Editar Producto</h4>
                </div>
                <div class="card-body">

                    <form asp-action="Editar" method="post">
                        <input type="hidden" asp-for="IdProducto" />
                        <input type="hidden" asp-for="Estado" />

                        <div class="mb-3">
                            <label class="form-label fw-bold">Nombre del Producto</label>
                            <input asp-for="Nombre" class="form-control" required />
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">Categoría</label>
                            <select asp-for="IdCategoria" asp-items="ViewBag.Categorias" class="form-select" required></select>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-bold">Precio (S/)</label>
                                <input asp-for="Precio" type="number" step="0.01" class="form-control" required />
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-bold">Stock Actual</label>
                                <input asp-for="Stock" type="number" class="form-control" required />
                            </div>
                        </div>

                        <div class="d-flex justify-content-between mt-4">
                            <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
                            <button type="submit" class="btn btn-warning">Actualizar Cambios</button>
                        </div>
                    </form>

                </div>
            </div>
        </div>
    </div>
</div>