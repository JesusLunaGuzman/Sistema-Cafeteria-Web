@model CafeteriaWeb.Dtos.ProductoDto

@{
    ViewData["Title"] = "Nuevo Producto";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow">
                <div class="card-header bg-success text-white">
                    <h4 class="mb-0">Crear Nuevo Producto</h4>
                </div>
                <div class="card-body">

                    <form asp-action="Crear" method="post">

                        <div class="mb-3">
                            <label class="form-label fw-bold">Nombre del Producto</label>
                            <input asp-for="Nombre" class="form-control" placeholder="Ej: Capuccino" required />
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">Categoría</label>
                            <select asp-for="IdCategoria" asp-items="ViewBag.Categorias" class="form-select" required>
                                <option value="">-- Seleccione una Categoría --</option>
                            </select>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-bold">Precio (S/)</label>
                                <input asp-for="Precio" type="number" step="0.01" class="form-control" placeholder="0.00" required />
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-bold">Stock Inicial</label>
                                <input asp-for="Stock" type="number" class="form-control" placeholder="0" required />
                            </div>
                        </div>

                        <div class="d-flex justify-content-between mt-4">
                            <a asp-action="Index" class="btn btn-secondary">Volver a la lista</a>
                            <button type="submit" class="btn btn-success">Guardar Producto</button>
                        </div>
                    </form>

                </div>
            </div>
        </div>
    </div>
</div>