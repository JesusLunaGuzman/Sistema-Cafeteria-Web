@model IEnumerable<CafeteriaWeb.Dtos.CategoriaDto>

@{
    ViewData["Title"] = "Categorías";
}

<div class="container mt-4">
    <h2>Mantenimiento de Categorías</h2>
    <hr />

    <a asp-action="Crear" class="btn btn-success mb-3">Nuevo Producto</a>
    <a asp-controller="Menu" asp-action="Index" class="btn btn-secondary mb-3 ms-2">Volver al Menú</a>

    <table class="table table-bordered table-striped">
        <thead class="table-dark">
            <tr>
                <th>ID</th>
                <th>Nombre</th>
                <th>Estado</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.IdCategoria</td>
                    <td>@item.Nombre</td>
                    <td>
                        @if (item.Estado)
                        {
                            <span class="badge bg-success">Activo</span>
                        }
                        else
                        {
                            <span class="badge bg-danger">Inactivo</span>
                        }
                    </td>
                    <td>
                        <a asp-action="Editar" asp-route-id="@item.IdCategoria" class="btn btn-warning btn-sm">Editar</a>
                        @if (item.Estado)
                        {
                            <a asp-action="Eliminar" asp-route-id="@item.IdCategoria" class="btn btn-danger btn-sm text-white" onclick="return confirm('¿Estás seguro que deseas dar de baja esta categoría?');">Eliminar</a>
                        }
                        else
                        {
                            <a asp-action="Activar" asp-route-id="@item.IdCategoria" class="btn btn-success btn-sm text-white" onclick="return confirm('¿Estás seguro que deseas volver a activar esta categoría?');">Activar</a>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>