@model IEnumerable<CafeteriaWeb.Dtos.ClienteDto>
@{
    ViewData["Title"] = "Clientes";
}

<div class="container mt-4">
    <h2>Mantenimiento de Clientes</h2>
    <hr />

    <a asp-action="Crear" class="btn btn-success mb-3">Nuevo Cliente</a>
    <a asp-controller="Menu" asp-action="Index" class="btn btn-secondary mb-3 ms-2">Volver al Menú</a>

    <div class="table-responsive shadow">
        <table class="table table-bordered table-striped mb-0">
            <thead class="table-dark">
                <tr>
                    <th>ID</th>
                    <th>Nombre</th>
                    <th>Email</th>
                    <th>Teléfono</th>
                    <th>Estado</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="align-middle">@item.IdCliente</td>
                        <td class="align-middle">@item.Nombre</td>
                        <td class="align-middle">@(item.Email ?? "-")</td>
                        <td class="align-middle">@(item.Telefono ?? "-")</td>
                        <td class="align-middle">
                            @if (item.Estado)
                            {
                                <span class="badge bg-success">Activo</span>
                            }
                            else
                            {
                                <span class="badge bg-danger">Inactivo</span>
                            }
                        </td>
                        <td class="align-middle">
                            <a asp-action="Editar" asp-route-id="@item.IdCliente" class="btn btn-warning btn-sm">Editar</a>

                            @if (item.Estado)
                            {
                                <a asp-action="Eliminar" asp-route-id="@item.IdCliente" class="btn btn-danger btn-sm text-white" onclick="return confirm('¿Estás seguro que deseas dar de baja este cliente?');">Eliminar</a>
                            }
                            else
                            {
                                <a asp-action="Activar" asp-route-id="@item.IdCliente" class="btn btn-success btn-sm text-white" onclick="return confirm('¿Estás seguro que deseas volver a activar este cliente?');">Activar</a>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>