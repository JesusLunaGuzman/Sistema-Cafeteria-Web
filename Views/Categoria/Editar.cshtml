@model CafeteriaWeb.Dtos.CategoriaDto

@{
    ViewData["Title"] = "Editar Categoría";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow">
                <div class="card-header bg-warning text-dark">
                    <h4 class="mb-0">Editar Categoría</h4>
                </div>
                <div class="card-body">

                    <form asp-action="Editar" method="post">
                        <input type="hidden" asp-for="IdCategoria" />
                        <input type="hidden" asp-for="Estado" />

                        <div class="mb-3">
                            <label class="form-label fw-bold">Nombre de la Categoría</label>
                            <input asp-for="Nombre" class="form-control" required />
                        </div>

                        <div class="d-flex justify-content-between mt-4">
                            <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
                            <button type="submit" class="btn btn-warning">Actualizar Cambios</button>
                        </div>
                    </form>

                </div>
            </div>
        </div>
    </div>
</div>