@model CafeteriaWeb.Dtos.CategoriaDto

@{
    ViewData["Title"] = "Nueva Categoría";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow">
                <div class="card-header bg-success text-white">
                    <h4 class="mb-0">Crear Nueva Categoría</h4>
                </div>
                <div class="card-body">

                    <form asp-action="Crear" method="post">
                        <div class="mb-3">
                            <label class="form-label fw-bold">Nombre de la Categoría</label>
                            <input asp-for="Nombre" class="form-control" placeholder="Ej: Bebidas Calientes" required />
                        </div>

                        <div class="d-flex justify-content-between mt-4">
                            <a asp-action="Index" class="btn btn-secondary">Volver a la lista</a>
                            <button type="submit" class="btn btn-success">Guardar Categoría</button>
                        </div>
                    </form>

                </div>
            </div>
        </div>
    </div>
</div>